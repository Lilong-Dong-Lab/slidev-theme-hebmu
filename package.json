{
  "name": "slidev-theme-hebmu",
  "version": "0.5.0",
  "description": "Slidev theme for Hebei Medical University (河北医科大学) academic teaching — Chinese-first typography, bilingual layouts, and session-based structure",
  "author": {
    "name": "Hugo Dong"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "slidev-theme",
    "slidev",
    "academic",
    "chinese",
    "hebmu"
  ],
  "files": [
    "assets",
    "components",
    "global-bottom.vue",
    "global-top.vue",
    "layout-helper.ts",
    "layouts",
    "README.md",
    "setup",
    "styles"
  ],
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "canvasWidth": 1024,
      "aspectRatio": "4/3",
      "fonts": {
        "sans": "PingFang SC",
        "mono": "Fira Code"
      },
      "themeConfig": {
        "paginationX": "r",
        "paginationY": "b",
        "footerMode": "compact",
        "logoUrl": "/hebmu-logo.png",
        "coverBackgroundUrl": "/campus-cover.jpeg",
        "endBackgroundUrl": "/campus-end.jpeg",
        "footerDepartment": "河北医科大学 基础医学院 医药信息学教研室",
        "paginationPagesDisabled": [
          1
        ]
      }
    }
  },
  "engines": {
    "node": ">=20.12.0",
    "slidev": ">=52.0.0 <53.0.0"
  },
  "scripts": {
    "dev": "slidev example.md --open",
    "build": "slidev build example.md",
    "check:dist": "node scripts/check-dist.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:surface": "node scripts/check-surface.mjs",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png",
    "watch-pr": "./scripts/watch-pr"
  },
  "dependencies": {
    "@slidev/types": "^52.0.0",
    "unocss": "^66.6.8"
  },
  "devDependencies": {
    "@slidev/cli": "^52.0.0",
    "playwright-chromium": "^1.52.0"
  },
  "allowScripts": {
    "esbuild": true,
    "playwright-chromium": true,
    "workerd": true,
    "fsevents": true
  },
  "peerDependencies": {
    "@slidev/cli": ">=52.0.0 <53.0.0"
  }
}
